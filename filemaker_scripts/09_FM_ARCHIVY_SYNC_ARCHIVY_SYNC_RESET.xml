<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><Text>ARCHIVY SYNC RESET - setzt Archivy_sync in der Vertraege-Tabelle auf leer. Dieses Script erst nach erfolgreichem 04, 03, 05 und 07 ausfuehren.</Text></Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[""]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$fehler</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[0]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$markiert</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[0]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$reset</Name>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[IsEmpty ( $$FM_VERTRAEGE_TABELLE )]]></Calculation>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[$fehler & "FM_VERTRAEGE_TABELLE fehlt. Bitte zuerst 01_FM_ARCHIVY_SYNC_INIT ausfuehren." & Char(182)]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$fehler</Name>
</Step>
<Step enable="True" id="69" name="Else"></Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[
MBS("FM.SQL.Execute"; "";
"SELECT count(*) FROM \"" & $$FM_VERTRAEGE_TABELLE & "\" WHERE \"Archivy_sync\" IN ('x','X')")
]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$sql_count</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[If ( Left ( $sql_count ; 5 ) = "[MBS]" ; 0 ; GetAsNumber ( MBS("FM.SQL.Field"; $sql_count; 0; 0 ) ) )]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$markiert</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[If ( Left ( $sql_count ; 5 ) = "[MBS]" ; $fehler & "Count fehlgeschlagen: " & Left ( $sql_count ; 220 ) & Char(182) ; $fehler )]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$fehler</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[If ( Left ( $sql_count ; 5 ) = "[MBS]" ; "" ; MBS("FM.SQL.Release"; $sql_count) )]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$rel_count</Name>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[$markiert > 0]]></Calculation>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[
MBS("FM.SQL.Execute"; "";
"UPDATE \"" & $$FM_VERTRAEGE_TABELLE & "\" SET \"Archivy_sync\" = '' WHERE \"Archivy_sync\" IN ('x','X')")
]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$sql_update</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[If ( Left ( $sql_update ; 5 ) = "[MBS]" ; $fehler & "Reset fehlgeschlagen: " & Left ( $sql_update ; 220 ) & Char(182) ; $fehler )]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$fehler</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[Case ( Left ( $sql_update ; 5 ) = "[MBS]" ; 0 ; $markiert )]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$reset</Name>
</Step>
<Step enable="True" id="69" name="Else"></Step>
<Step enable="True" id="70" name="End If"></Step>
<Step enable="True" id="70" name="End If"></Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[
"RESET Archivy_sync: markiert=" & $markiert & " reset=" & $reset &
" fehler=" & If ( IsEmpty ( $fehler ) ; "keine" ; Left ( $fehler ; 500 ) )
]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$$SYNC_RESULT_V</Name>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Value><Calculation><![CDATA[MBS("Msgbox"; $$SYNC_RESULT_V)]]></Calculation></Value>
<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
<Name>$msg</Name>
</Step>
</fmxmlsnippet>
